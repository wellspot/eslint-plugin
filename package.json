{
  "name": "@wellspot/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules that catch code patterns known to trigger React Compiler bugs that are not yet fixed upstream.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react",
    "react-compiler"
  ],
  "license": "MIT",
  "author": "Wellspot",
  "homepage": "https://github.com/wellspot/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellspot/eslint-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/wellspot/eslint-plugin/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "node scripts/smoke-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:package": "publint && attw --pack . --profile node16",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:dist && npm run lint:package",
    "new-rule": "node scripts/new-rule.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
